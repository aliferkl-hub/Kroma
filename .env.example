# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for OAuth callbacks (e.g. /api/integrations/mercadolivre/oauth/callback)
APP_URL="MY_APP_URL"

# MASTER_ENCRYPTION_KEY: 32-byte hex or string key used for AES-256-GCM credentials encryption.
# If not provided, a secure key is automatically derived and persisted locally.
MASTER_ENCRYPTION_KEY="replace_with_a_secure_32_byte_secret_key"

# MASTER_OWNER_EMAIL and MASTER_OWNER_PASSWORD for administrative authentication
MASTER_OWNER_EMAIL="admin@vendplus.com.br"
MASTER_OWNER_PASSWORD="change_in_production_secure_pass_2026"

# SUPABASE PERSISTENCE (Optional - if provided, syncs with Supabase database)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# MERCADO PAGO INTEGRATION (For native checkout and dropshipping orders)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
